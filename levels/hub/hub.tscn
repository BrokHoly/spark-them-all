modulate = Color(0.8516663, 0.9293918, 0.9649566, 1)
outline_modulate = Color(0.4548102, 0.103578724, 0.12167155, 1)
text = "Pour la petite histoire : 
Vos ennemies sont les Boulars, 
des créature des cavernes en forme de boule.
Elles sont sensibles à la lumière.
Ramassez leur butin à leur mort pour améliorer vos compétences.
_
Faites les tous BRILLER
SPARK THEM ALL!!
"
font_size = 47
